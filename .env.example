# ==============================================================================
# JARVIS Personal AI Operating System - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and populate with your local configuration and keys.
# Never commit .env containing real credentials or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Credentials & Authentication
# ------------------------------------------------------------------------------
# Google Gemini API Key (Required for Live Audio & Multimodal Cognition)
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Optional for ultra-fast text model routing and fallback inference)
# Get a key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# 2. Identity, Persona & Voice Configuration
# ------------------------------------------------------------------------------
APP_NAME=JARVIS
APP_VERSION=1.0.0
ENVIRONMENT=development
USER_CALLSIGN=Sir
VOICE_DEFAULT_NAME=Algenib

# ------------------------------------------------------------------------------
# 3. Audio Capture & Hardware Pipeline Settings
# ------------------------------------------------------------------------------
# Audio input device index (leave blank for automatic Windows default communication device)
AUDIO_INPUT_DEVICE_INDEX=
AUDIO_INPUT_SAMPLE_RATE=16000
AUDIO_INPUT_CHANNELS=1
AUDIO_INPUT_CHUNK_MS=30
AUDIO_OUTPUT_SAMPLE_RATE=24000
AUDIO_VAD_ENERGY_THRESHOLD=15.0
AUDIO_DUPLEX_SUPPRESSION=true
VOICE_DRAIN_HOLD_MS=250

# ------------------------------------------------------------------------------
# 4. Acoustic Echo Cancellation (AEC) & DSP Pipeline
# ------------------------------------------------------------------------------
# Realtime hardware loopback reference subtraction to eliminate speaker feedback
AUDIO_AEC_ENABLED=true
AUDIO_AEC_PARTITIONS=6
AUDIO_AEC_STEP_SIZE=0.25
AUDIO_AEC_SUPPRESSION_DB=30.0
AUDIO_AEC_DELAY_MAX_MS=250
# Directory to store debug audio WAV dumps (optional, leave blank to disable)
AUDIO_AEC_DIAGNOSTICS_DIR=

# ------------------------------------------------------------------------------
# 5. Gateway Daemon & Network Server
# ------------------------------------------------------------------------------
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8765
GATEWAY_PORT_AUTO_DISCOVERY=true
GATEWAY_PORT_SEARCH_LIMIT=50
HTTP_PORT=8000

# ------------------------------------------------------------------------------
# 6. Browser & Web Automation
# ------------------------------------------------------------------------------
BROWSER_HEADLESS=false
BROWSER_CHANNEL=chrome

# ------------------------------------------------------------------------------
# 7. Real-Time Web Search
# ------------------------------------------------------------------------------
WEB_SEARCH_ENDPOINT=https://html.duckduckgo.com/html/
WEB_SEARCH_TIMEOUT_SECONDS=10.0
WEB_SEARCH_MAX_RESULTS=5

# ------------------------------------------------------------------------------
# 8. Security, Policy & Safety Controls
# ------------------------------------------------------------------------------
# Require user approval for privileged or irreversible tool actions
REQUIRE_APPROVALS=true
DEFAULT_TIMEOUT_SECONDS=60.0
MAX_SUBAGENT_DEPTH=3
DEFAULT_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 9. Dynamic Cognitive Model Mappings
# ------------------------------------------------------------------------------
MODEL_MAP_GEMINI_LIVE=gemini-3.8-live
MODEL_MAP_GEMINI_3_1_FLASH_LITE=gemini-2.5-flash-lite
MODEL_MAP_GEMINI_3_5_FLASH_LITE=gemini-2.5-flash
MODEL_MAP_GEMMA_4_31B=gemini-2.5-flash
MODEL_MAP_GPT_OSS_120B=openai/gpt-oss-120b
MODEL_MAP_QWEN_3_8_27B=qwen/qwen3.8-27b

# ------------------------------------------------------------------------------
# 10. Autonomous WhatsApp VoIP Calling Engine
# ------------------------------------------------------------------------------
# Enable or disable autonomous WhatsApp VoIP capabilities
WHATSAPP_VOIP_ENABLED=true
# WhatsApp Web session credentials directory (leave blank for substrate/extensions/whatsapp-voice/auth)
WHATSAPP_AUTH_DIR=
# JSON contacts directory or file path for name-to-phone mapping
WHATSAPP_CONTACTS_FILE=
# Default international dialing country code without '+' (e.g. 91 for India, 1 for US)
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Preferred voice language for phone calls (e.g. 'en-US', 'hi-IN', 'hinglish')
WHATSAPP_CALL_LANGUAGE=en-US
# Default autonomous conversation mode ('MESSAGE_DELIVERY', 'CONVERSATIONAL', 'EMERGENCY')
WHATSAPP_CONVERSATION_MODE=MESSAGE_DELIVERY
# Maximum duration per call in milliseconds
WHATSAPP_CALL_TIMEOUT_MS=120000

# ------------------------------------------------------------------------------
# 11. Native Telegram Remote Control Daemon
# ------------------------------------------------------------------------------
# Telegram Bot Token from @BotFather (keep secret)
TELEGRAM_BOT_TOKEN=
# Enable or disable background Telegram bot daemon
TELEGRAM_BOT_ENABLED=true
# Validity window for one-time pairing challenge links in seconds
TELEGRAM_PAIRING_TTL_SECONDS=300
# Validity window for privileged action approval tickets in seconds
TELEGRAM_APPROVAL_TTL_SECONDS=300
# Minimum interval between in-place card edits in seconds to prevent rate limiting
TELEGRAM_RATE_LIMIT_EDIT_INTERVAL=1.0
# Maximum file upload size in bytes for inbound Telegram attachments (default: 50MB)
TELEGRAM_MAX_UPLOAD_BYTES=52428800
# Dedicated Google Gemini API Key for Telegram Remote Control (falls back to GEMINI_API_KEY if unset)
TELEGRAM_GEMINI_API_KEY=
# Dedicated Gemini model for Telegram Remote Control Live session (default: gemini-3.8-live)
TELEGRAM_GEMINI_MODEL=gemini-3.8-live


