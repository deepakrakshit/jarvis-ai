# ==============================================================================
# JARVIS v1.0.0: Master Environment Configuration Template
# Copy this file to '.env' and populate your active API keys.
# DO NOT commit '.env' to public version control!
# ==============================================================================

# ==============================================================================
# 1. PRIMARY API KEYS (Free-Tier Providers)
# ==============================================================================
# Google AI Studio API Key (Get free key at: https://aistudio.google.com/)
# Provides: Gemini 3.5/3.1 Flash-Lite, Gemini 3.5-3.8 Flash, Gemma 4 31B, Embedding 2
GEMINI_API_KEY=your_google_ai_studio_key_here

# Groq Cloud API Key (Get free key at: https://console.groq.com/)
# Provides: Qwen 3.8-27B (Coding), GPT-OSS 120B (Research & Browser Search)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (Optional free fallback pool at: https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_key_optional

# ==============================================================================
# 2. MODEL GATEWAY ROSTER CONFIGURATION
# ==============================================================================
# Layer 07: Capability Router & Intent Classifier (Pool B: 500 RPD)
ROUTER_MODEL=gemini-3.1-flash-lite

# Layer 08: Default Everyday Brain for General Tasks & Tools (Pool B: 500 RPD)
DEFAULT_BRAIN_MODEL=gemini-3.5-flash-lite

# Layer 08: Bulk Summarization, Context Compression & Memory Polishing (Pool C: 14,400 RPD)
SUMMARIZER_MODEL=gemma-4-31b

# Layer 08: Fast Coding Specialist (Pool D: 1,000 RPD on Groq)
CODING_SPECIALIST_MODEL=qwen/qwen3.8-27b

# Layer 08: Research & Browser Search Specialist (Pool D: 1,000 RPD on Groq)
RESEARCH_SPECIALIST_MODEL=openai/gpt-oss-120b

# Layer 08: Multimodal Vision & Complex Software Engineering (Pool A: 20 RPD)
ESCALATION_BRAIN_MODEL=gemini-3.8-flash

# Layer 17: Multimodal Vector Embeddings (1,000 RPD)
EMBEDDING_MODEL=gemini-embedding-2

# ==============================================================================
# 3. FLASH POOL ROTATION (Capability-Weighted 80 RPD Pool)
# ==============================================================================
# Models participating in the capability-weighted rotation
FLASH_POOL_MODELS=["gemini-3.5-flash", "gemini-3.6-flash", "gemini-3.7-flash", "gemini-3.8-flash"]
FLASH_POOL_RPD_LIMIT=20
FLASH_POOL_TPM_LIMIT=250000

# ==============================================================================
# 4. POLICY ENGINE, SECURITY & AUTONOMY
# ==============================================================================
# Autonomy Level (0 to 5):
#   0 = Observe Only (No execution)
#   1 = Recommend Action (User executes)
#   2 = Auto-Execute Safe/Read-Only (Default recommended)
#   3 = Auto-Execute Bounded Mutations in Workspace
#   4 = Fully Autonomous within Spend Budget
#   5 = Mandatory Human Approval for ALL Mutations
AUTONOMY_LEVEL=2

# Safe Mode: Restricts all OS mutations to workspace/temp boundaries
SAFE_MODE=true

# Human-In-The-Loop Approval Expiration (seconds)
APPROVAL_TIMEOUT_SECONDS=300

# ==============================================================================
# 5. CONTROL PLANE & COMPUTATION BUDGETS
# ==============================================================================
# Hard upper limit on LangGraph state transitions per task
MAX_GRAPH_STEPS=25

# Hard limit on external tool executions per task
MAX_TOOL_CALLS=50

# Absolute timeout per task (seconds)
MAX_WALL_TIME_SECONDS=300

# Dollar spend cap circuit breaker per task
MAX_COST_USD=2.00

# Maximum ephemeral subagents a Deep Agent may spawn concurrently
MAX_SUBAGENTS=4

# ==============================================================================
# 6. EDGE GATEWAY & NETWORKING
# ==============================================================================
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
WEBSOCKET_HEARTBEAT_INTERVAL=15
CORS_ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# ==============================================================================
# 7. VOICE PIPELINE (Edge-TTS)
# ==============================================================================
# Voice identity for JARVIS (British Butler accent)
VOICE_NAME=en-GB-RyanNeural
VOICE_RATE=+0%
VOICE_VOLUME=+0%
VOICE_PITCH=+0Hz

# ==============================================================================
# 8. MEMORY & STORAGE PATHS
# ==============================================================================
# Local SQLite checkpoint database for LangGraph state persistence
SQLITE_DB_PATH=./data/jarvis_state.db

# Embedded Vector Database path for Semantic Memory
VECTOR_DB_PATH=./data/vector_store

# Ephemeral artifacts workspace directory
WORKSPACE_ARTIFACTS_PATH=./workspace/artifacts

# Dead Letter Queue storage path
DLQ_STORAGE_PATH=./data/dlq

# ==============================================================================
# 9. OBSERVABILITY & AUDIT LOGGING
# ==============================================================================
LOG_LEVEL=INFO
ENABLE_STRUCTURED_JSON_LOGS=true
REDACT_SECRETS_IN_LOGS=true
LANGCHAIN_TRACING_V2=false
# Optional LangSmith API key for trace visualization
LANGCHAIN_API_KEY=your_langsmith_key_optional
LANGCHAIN_PROJECT=JARVIS-v1
