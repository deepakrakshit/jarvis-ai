# ==============================================================================
# JARVIS Personal AI Operating System - Environment Configuration
# ==============================================================================
# Copy this file to .env:
#   copy .env.example .env
#
# Only the primary Google Gemini API key is required to boot and run JARVIS.
# Optional integrations (Groq, Telegram, WhatsApp) can be configured as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Intelligence (REQUIRED)
# ------------------------------------------------------------------------------
# Google Gemini API Key: Powers Gemini 3.8 Live realtime voice and multimodal cognition.
# Obtain a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Fast Text Routing & Fallbacks (OPTIONAL)
# ------------------------------------------------------------------------------
# Groq API Key: Enables high-speed text model fallback routing (Qwen, GPT-OSS).
# Obtain a key from: https://console.groq.com/
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 3. Telegram Remote Control (OPTIONAL)
# ------------------------------------------------------------------------------
# Telegram Bot Token: Create a bot with @BotFather on Telegram to control
# your Windows PC, request files, and supervise tasks remotely from your phone.
TELEGRAM_BOT_TOKEN=

# Dedicated Gemini API Key for Telegram: (Optional) If you want a separate quota
# for mobile Telegram sessions. Automatically falls back to GEMINI_API_KEY if unset.
TELEGRAM_GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. WhatsApp Autonomous Telephony (OPTIONAL)
# ------------------------------------------------------------------------------
# Enable or disable autonomous outbound voice calling over WhatsApp WebRTC
WHATSAPP_VOIP_ENABLED=true

# Default country calling code without '+' (e.g. 91 for India, 1 for US)
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Preferred language for voice calls ('hinglish', 'en-US', 'hi-IN')
WHATSAPP_CALL_LANGUAGE=hinglish

# ------------------------------------------------------------------------------
# 5. Assistant Persona (OPTIONAL)
# ------------------------------------------------------------------------------
# Preferred honorific or callsign JARVIS uses when addressing you
USER_CALLSIGN=Sir
